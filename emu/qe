#!/usr/bin/env bash
# qe <command...>: run a command in the emulator host container (QEMU, QEngine's build tools, vncdo), as you, with the same
# paths as outside, the Docker socket (QEngine's builders start sibling containers) and the host network (serial, monitor, VNC).
#   QENGINE   the QEngine checkout (default ../../QEngine)       FIRMWARE_DIR  where the update images are (read-only)
#   QE_RUNLOCK, QE_INSTANCE  a lock file of this container's own in place of the instance's: for jobs.py, whose emulators share an
#                            instance's read-only images but each write their own overlays, which is what that lock protects
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"; pm="${PM:-$(cd "$here/../../plugin-manager" && pwd)}"; compat="$(cd "$here/.." && pwd)"
QENGINE="${QENGINE:-$(cd "$pm/.." && pwd)/QEngine}"
FIRMWARE_DIR="${FIRMWARE_DIR:-$(cd "$pm/../.." && pwd)/incubating/akai-firmware}"
MPC_VST="${MPC_VST:-$(cd "$pm/../.." && pwd)/open-mpc}"
docker image inspect pm-emu-host >/dev/null 2>&1 || docker build -q -t pm-emu-host "$here" >/dev/null
tty=; [ -t 0 ] && tty=-it
pass=(); for v in PM_EMU_STATE SERIAL QEMU_AUDIO QEMU_EXTRA_ARGS KERNEL_EXTRA_ARGS MEM SMP ACCEL CPU SSH_PORT VNC_DISPLAY SERIAL_PORT MONITOR_PORT AUDIODEV_BACKEND PM_FIRMWARE_SHA256 PM_PRODUCT_CODE PM_QENGINE_REF PM_EMU_TIMESCALE; do [ -z "${!v+x}" ] || pass+=(-e "$v"); done
mkdir -p /tmp/pm-emu-home; printf 'root:x:0:0:root:/root:/bin/sh\nemu:x:%s:%s:emu:/tmp/pm-emu-home:/bin/sh\n' "$(id -u)" "$(id -g)" > /tmp/pm-emu-home/passwd   # ssh wants a name for the uid
:   # /tmp is shared: QEngine bind-mounts scripts it writes there into its builder containers
exec docker run --rm $tty ${QE_CPUS:+--cpus "$QE_CPUS"} ${QE_HOSTNET:+--network host} ${QE_NONET:+--network none} -u "$(id -u):$(id -g)" --group-add "$(stat -c %g /var/run/docker.sock)" \
  -v /var/run/docker.sock:/var/run/docker.sock -v /tmp:/tmp -v /tmp/pm-emu-home/passwd:/etc/passwd:ro -e HOME=/tmp/pm-emu-home -v "$QENGINE:$QENGINE" -v "$pm:$pm" -v "$compat:$compat" -v "$FIRMWARE_DIR:$FIRMWARE_DIR:ro" -v "$MPC_VST:$MPC_VST:ro" \
  -e QENGINE="$QENGINE" -e FIRMWARE_DIR="$FIRMWARE_DIR" -e MPC_VST="$MPC_VST" -e PM="$pm" "${pass[@]}" ${QE_RUNLOCK:+-v "$QE_RUNLOCK:$QENGINE/build/instances/$QE_INSTANCE/.run.lock"} ${QE_NAME:+--name "$QE_NAME"} ${QE_DETACH:+-d} \
  -w "${QE_CWD:-$QENGINE}" pm-emu-host "$@"
